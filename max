```html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>سايكو VIV</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Tahoma, sans-serif;
            background: #050505;
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 360px;
            max-width: 92%;
            padding: 25px 20px;
            background: #080808;
            border: 2px solid #00ff22;
            border-radius: 16px;
            box-shadow:
                0 0 10px #00ff22,
                0 0 25px rgba(0, 255, 34, 0.45),
                0 0 50px rgba(0, 255, 34, 0.15);
            text-align: center;
        }

        .logo {
            font-size: 30px;
            font-weight: bold;
            color: #00ff22;
            margin-bottom: 8px;
            text-shadow: 0 0 12px #00ff22;
        }

        .subtitle {
            color: #aaa;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .buttons {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: 2px solid #00ff22;
            border-radius: 10px;
            background: transparent;
            color: white;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.25s;
        }

        .btn:hover {
            background: #00ff22;
            color: #000;
            box-shadow: 0 0 18px #00ff22;
            transform: translateY(-2px);
        }

        .btn:active {
            transform: scale(0.97);
        }

        .message {
            display: none;
            margin-top: 20px;
            padding: 13px;
            border-radius: 9px;
            border: 1px solid #00ff22;
            color: #00ff22;
            background: rgba(0, 255, 34, 0.05);
            font-size: 14px;
        }

        .footer {
            margin-top: 22px;
            color: #666;
            font-size: 12px;
        }

        /* نافذة إنشاء الحساب */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.88);
            justify-content: center;
            align-items: center;
            padding: 15px;
            z-index: 1000;
        }

        .modal-box {
            width: 350px;
            max-width: 100%;
            background: #080808;
            border: 2px solid #00ff22;
            border-radius: 15px;
            padding: 22px;
            box-shadow: 0 0 30px rgba(0, 255, 34, 0.45);
            text-align: center;
        }

        .modal-title {
            color: #00ff22;
            font-size: 23px;
            margin-bottom: 20px;
        }

        .input {
            width: 100%;
            padding: 13px;
            margin-bottom: 13px;
            background: #050505;
            color: white;
            border: 1px solid #00ff22;
            border-radius: 8px;
            outline: none;
            font-size: 15px;
            text-align: right;
        }

        .input:focus {
            box-shadow: 0 0 10px rgba(0, 255, 34, 0.5);
        }

        .create-btn {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 8px;
            background: #00ff22;
            color: #000;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 3px;
        }

        .close-btn {
            width: 100%;
            padding: 11px;
            margin-top: 10px;
            background: transparent;
            color: #aaa;
            border: 1px solid #444;
            border-radius: 8px;
            cursor: pointer;
        }

        .success {
            display: none;
            margin-top: 15px;
            padding: 14px;
            border: 1px solid #00ff22;
            border-radius: 9px;
            color: #00ff22;
            line-height: 1.8;
        }

        .success strong {
            color: #00ff22;
        }

        @media (max-width: 400px) {
            .container {
                padding: 22px 16px;
            }

            .logo {
                font-size: 27px;
            }

            .btn {
                font-size: 16px;
                padding: 13px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="logo">سايكو VIV</div>

        <div class="subtitle">
            مرحباً بك، اختر الخدمة المطلوبة
        </div>

        <div class="buttons">

            <button class="btn" onclick="openSignup()">
                إنشاء حساب جديد
            </button>

            <button class="btn" onclick="contactOffice()">
                تواصل مع المكتب
            </button>

            <button class="btn" onclick="chargeBalance()">
                شحن رصيد
            </button>

        </div>

        <div id="message" class="message"></div>

        <div class="footer">
            جميع الحقوق محفوظة © 2026
        </div>

    </div>


    <!-- نافذة إنشاء حساب -->

    <div id="signupModal" class="modal">

        <div class="modal-box">

            <div class="modal-title">
                إنشاء حساب جديد
            </div>

            <input
                id="username"
                class="input"
                type="text"
                placeholder="اسم المستخدم"
            >

            <input
                id="password"
                class="input"
                type="password"
                placeholder="كلمة المرور"
            >

            <button class="create-btn" onclick="createAccount()">
                إنشاء حساب
            </button>

            <div id="success" class="success"></div>

            <button class="close-btn" onclick="closeSignup()">
                إغلاق
            </button>

        </div>

    </div>


    <script>

        // فتح نافذة إنشاء الحساب
        function openSignup() {
            document.getElementById("signupModal").style.display = "flex";
        }

        // إغلاق النافذة
        function closeSignup() {
            document.getElementById("signupModal").style.display = "none";
        }

        // إنشاء الحساب
        function createAccount() {

            const username =
                document.getElementById("username").value.trim();

            const password =
                document.getElementById("password").value.trim();

            if (username === "" || password === "") {
                alert("يرجى إدخال اسم المستخدم وكلمة المرور");
                return;
            }

            // رقم حساب تجريبي
            const accountNumber =
                Math.floor(100000 + Math.random() * 900000);

            const success =
                document.getElementById("success");

            success.style.display = "block";

            success.innerHTML = `
                <div>تم إنشاء الحساب بنجاح</div>
                <div>
                    رقم الحساب:
                    <strong>${accountNumber}</strong>
                </div>
                <div>
                    كلمة المرور:
                    <strong>${password}</strong>
                </div>
            `;
        }


        // تواصل مع المكتب
        function contactOffice() {

            const message =
                document.getElementById("message");

            message.style.display = "block";

            message.innerHTML =
                "للتواصل مع المكتب يرجى استخدام وسيلة التواصل الخاصة بك.";
        }


        // شحن الرصيد
        function chargeBalance() {

            const message =
                document.getElementById("message");

            message.style.display = "block";

            message.innerHTML =
                "خدمة شحن الرصيد متاحة، يرجى التواصل مع المكتب لإتمام عملية الشحن.";
        }


        // إغلاق النافذة عند الضغط خارجها
        document.getElementById("signupModal")
            .addEventListener("click", function(event) {

                if (event.target === this) {
                    closeSignup();
                }

            });

    </script>

</body>
</html>
